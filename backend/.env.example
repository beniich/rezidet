# ============== APPLICATION ==============
NODE_ENV=production
PORT=5000
APP_URL=https://cafm.app
API_URL=https://api.cafm.app

# ============== BASE DE DONNÉES ==============
DATABASE_URL=postgresql://user:password@host:5432/cafm_prod?schema=public
SHADOW_DATABASE_URL=postgresql://user:password@host:5432/cafm_shadow

# ============== AUTHENTIFICATION ==============
JWT_SECRET=CHANGEZ_CELA_PAR_UNE_CLE_ALEATOIRE_64_CARACTERES_MIN
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ============== EMAIL (Resend) ==============
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@cafm.com

# ============== IA ==============
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx

# ============== PUSH NOTIFICATIONS ==============
VAPID_PUBLIC_KEY=BOBnWxXXXXXXXXXXXXXXXXXXXXXXXXX
VAPID_PRIVATE_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ============== CORS ==============
CORS_ORIGIN=https://cafm.app,https://www.cafm.app

# ============== RATE LIMITING ==============
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# ============== MONITORING ==============
SENTRY_DSN=https://xxx@sentry.io/xxx
LOG_LEVEL=info
